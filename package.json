{
  "name": "ominous-security",
  "version": "1.2.0",
  "description": "Analiza repositorios de GitHub antes de clonarlos: vulnerabilidades, amenazas deliberadas y payloads ocultos.",
  "main": "server.js",
  "bin": {
    "ominous-scan": "bin/ominous-scan.js"
  },
  "scripts": {
    "start": "node server.js",
    "lint": "node scripts/lint.js",
    "test": "node --test test/*.test.js",
    "test:ci": "node --test --experimental-test-coverage --test-coverage-include=lib/** --test-coverage-include=bin/** --test-coverage-include=server.js --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=junit.xml test/*.test.js",
    "scan:self": "node bin/ominous-scan.js . --exclude lib/rules.js,lib/decoder.js,lib/extra.js,public/index.html,public/analyzer.js,README.md,test/,node_modules/ --fail-on red",
    "build:site": "node scripts/build-site.js dist",
    "build:web": "node scripts/build-web.js",
    "update:data": "node scripts/update-data.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "server.js",
    "lib/",
    "data/",
    "bin/",
    "public/",
    "README.md",
    "LICENSE"
  ],
  "optionalDependencies": {
    "@anthropic-ai/sdk": "0.128.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexDBdevops/ominous-security.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@noble/ciphers": "2.0.1",
    "@noble/hashes": "2.0.1",
    "buffer": "6.0.3",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "path-browserify": "1.0.1"
  }
}
